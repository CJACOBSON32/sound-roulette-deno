{
  "tasks": {
    "debug": "deno run -P --env-file --watch --inspect-brk ./src/main.ts",
    "dev": "deno run -P --env-file --watch ./src/main.ts"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1",
    "discord.js": "npm:discord.js@^14.25.1"
  },
  "lint": {
    "include": ["src/"],
    "exclude": ["src/testdata/", "src/fixtures/**/*.ts"],
    "rules": {
      "tags": ["recommended"]
    }
  },
  "permissions": {
    "default":  {
      "read": true,
      "write": true,
      "env": true,
      "net": true
    }
  }
}
